*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- 虚拟环境（全部存 D 盘项目内，不提交）---
venv/
env/
ENV/
.venv/
.pip_cache/

# ---  IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- 项目运行产物（全部存 D 盘，不提交）---
output/
logs/
vector_store/
data/
*.log
*.log.*

# --- 环境变量 ---
.env
.env.local
.env.*.local

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 测试与覆盖率 ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
